<body>
<script>
window.onerror = function(msg, url, line, col, err) {
  try {
    var div = document.createElement('div');
    div.id = 'jsErrorBar';
    div.style.cssText = 'position:fixed;top:0;left:0;right:0;background:#7f1d1d;color:#fff;padding:10px 14px;z-index:99999;font-size:12.5px;line-height:1.5;font-family:monospace;word-break:break-all';
    div.textContent = 'JS 错误 [行 ' + line + ':' + col + '] ' + msg;
    document.body.appendChild(div);
  } catch (e) {}
};
</script>
<div class="topbar">
  <h1>GitHub 发布工具</h1>
  <nav>
    <a href="{{ url_for('index') }}" {% if request.endpoint=='index' %}class="active"{% endif %}>首页</a>
    <a href="{{ url_for('repos_page') }}" {% if request.endpoint=='repos_page' %}class="active"{% endif %}>项目</a>
    <a href="{{ url_for('tasks') }}" {% if request.endpoint=='tasks' %}class="active"{% endif %}>任务</a>
    <a href="{{ url_for('setup') }}" {% if request.endpoint=='setup' %}class="active"{% endif %}>设置</a>
    <a href="{{ url_for('logout') }}">退出</a>
  </nav>
</div>
<div class="wrap">
{% block body %}{% endblock %}
</div>

<div id="modal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <div class="modal-head">
      <button class="modal-back" type="button" id="modalBackBtn" onclick="modalBack()" style="display:none">← 返回</button>
      <button class="modal-back" type="button" id="modalEditBtn" onclick="startEditFromPreview()" style="display:none">✏ 编辑</button>
      <button class="modal-back" type="button" id="modalHistoryBtn" onclick="showFileHistory()" style="display:none">📜 历史</button>
      <span class="modal-title" id="modalTitle">日志</span>
      <button class="modal-close" type="button" onclick="closeModal()" aria-label="关闭">✕</button>
    </div>
    <div class="steps-bar" id="modalSteps" style="display:none"></div>
    <div class="upload-progress" id="uploadProgress">
      <div class="info"><span id="uploadLabel">正在上传</span><span class="pct" id="uploadPct">0%</span></div>
      <div class="bar-wrap"><div class="bar" id="uploadBar"></div></div>
      <div class="info" style="margin-top:6px;color:#8b9cba;font-weight:400"><span id="uploadBytes"></span><span id="uploadSpeed"></span></div>
    </div>
    <div id="modalExtras" class="modal-extras"></div>
    <pre class="log" id="modalLog">加载中...</pre>
    <div class="file-list" id="modalFileList" style="display:none"></div>

    <div class="modal-editor" id="modalEditor">
      <div class="editor-toolbar">
        <span class="editor-path" id="editorPath"></span>
        <span class="editor-actions">
          <button class="ghost" type="button" onclick="cancelEdit()">取消</button>
          <button type="button" onclick="saveEdit()" id="saveEditBtn">保存</button>
        </span>
      </div>
      <textarea id="editorTextarea" spellcheck="false"></textarea>
    </div>
  </div>


<div id="syncDialog" class="modal-overlay" style="display:none;z-index:200"></div>

<script>
function escHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

window.onModalBack = null;
function modalBack() {
  if (typeof window.onModalBack === 'function') window.onModalBack();
}
function showBackBtn(show) {
  var b = document.getElementById('modalBackBtn');
  if (b) b.style.display = show ? 'inline-block' : 'none';
}


function showUploadProgress(loaded, total, startTime) {
  var el = document.getElementById('uploadProgress');
  if (!el) return;
  el.className = 'upload-progress show';
  var pct = total > 0 ? Math.round(loaded / total * 100) : 0;
  document.getElementById('uploadPct').textContent = pct + '%';
  document.getElementById('uploadBar').style.width = pct + '%';
  var mb = (loaded / 1024 / 1024).toFixed(1);
  var totalMb = (total / 1024 / 1024).toFixed(1);
  document.getElementById('uploadBytes').textContent = mb + ' / ' + totalMb + ' MB';
  if (startTime) {
    var elapsed = (Date.now() - startTime) / 1000;
    if (elapsed > 0.3) {
      var speed = (loaded / elapsed / 1024 / 1024).toFixed(1);
      document.getElementById('uploadSpeed').textContent = speed + ' MB/s';
    }
  }
  if (pct >= 100) {
    document.getElementById('uploadLabel').textContent = '上传完成，正在处理';
  } else {
    document.getElementById('uploadLabel').textContent = '正在上传';
  }
}

function hideUploadProgress() {
  var el = document.getElementById('uploadProgress');
  if (el) el.className = 'upload-progress';
}


var _editCtx = {owner: '', repo: '', path: '', sha: '', content: ''};

function showEditBtn(show) {
  var b = document.getElementById('modalEditBtn');
  if (b) b.style.display = show ? 'inline-block' : 'none';
}

function startEditFromPreview() {
  if (!window._lastFileData) return;
  var d = window._lastFileData;
  _editCtx = {owner: d.owner, repo: d.repo, path: d.path, sha: d.sha, content: d.content};
  document.getElementById('editorPath').textContent = d.path;
  document.getElementById('editorTextarea').value = d.content;
  // 切换视图
  document.getElementById('modalLog').style.display = 'none';
  document.getElementById('modalFileList').style.display = 'none';
  var ex = document.getElementById('modalExtras');
  if (ex) ex.className = 'modal-extras';
  document.getElementById('modalSteps').style.display = 'none';
  document.getElementById('modalEditor').className = 'modal-editor show';
  document.getElementById('modalEditBtn').style.display = 'none';
  // 光标定位
  var ta = document.getElementById('editorTextarea');
  ta.focus();
  ta.setSelectionRange(0, 0);
}

function cancelEdit() {
  document.getElementById('modalEditor').className = 'modal-editor';
  document.getElementById('modalLog').style.display = 'block';
  if (window._lastFileData) showEditBtn(true);
}

async function saveEdit() {
  var content = document.getElementById('editorTextarea').value;
  if (content === _editCtx.content) {
    cancelEdit();
    return;
  }
  var message = await myPrompt({
    title: '提交修改',
    message: _editCtx.path,
    defaultValue: 'update ' + _editCtx.path,
    placeholder: 'commit message'
  });
  if (message === null) return;
  if (!message.trim()) message = 'update ' + _editCtx.path;

  var btn = document.getElementById('saveEditBtn');
  btn.disabled = true;
  btn.textContent = '保存中...';

  try {
    var r = await fetch('/api/repos/save_file', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        owner: _editCtx.owner,
        repo: _editCtx.repo,
        path: _editCtx.path,
        content: content,
        sha: _editCtx.sha,
        message: message.trim()
      })
    });
    var j = await r.json();
    if (j.error) {
      alert('保存失败: ' + j.error);
      return;
    }
    // 更新缓存
    _editCtx.content = content;
    if (window._lastFileData) {
      window._lastFileData.content = content;
    }
    // 回预览
    document.getElementById('modalEditor').className = 'modal-editor';
    document.getElementById('modalLog').style.display = 'block';
    showEditBtn(true);
    // 重新渲染
    if (typeof window._reloadPreview === 'function') window._reloadPreview();
    var tip = j.commit_url ? ('\n\n提交：' + j.commit_url) : '';
    setTimeout(function() {
      var log = document.getElementById('modalLog');
      log.innerHTML += '<div style="margin-top:14px;padding-top:10px;border-top:1px solid #1e293b;color:#34d399">✅ 已保存' + tip + '</div>';
    }, 100);
  } catch (e) {
    alert('保存失败: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = '保存';
  }
}


var _histCtx = {owner: '', repo: '', path: '', expanded: null};

function showHistoryBtn(show) {
  var b = document.getElementById('modalHistoryBtn');
  if (b) b.style.display = show ? 'inline-block' : 'none';
}

async function showFileHistory() {
  if (!window._lastFileData) return;
  var d = window._lastFileData;
  _histCtx = {owner: d.owner, repo: d.repo, path: d.path, expanded: null};

  // 切到日志视图
  document.getElementById('modalEditor').className = 'modal-editor';
  document.getElementById('modalFileList').style.display = 'none';
  document.getElementById('modalSteps').style.display = 'none';
  document.getElementById('modalLog').style.display = 'block';
  document.getElementById('modalLog').innerHTML = '<div class="diff-empty">加载提交历史...</div>';
  showEditBtn(false);
  showHistoryBtn(false);

  try {
    var r = await fetch('/api/repos/file_history?owner=' + encodeURIComponent(d.owner) +
                        '&repo=' + encodeURIComponent(d.repo) +
                        '&path=' + encodeURIComponent(d.path));
    var j = await r.json();
    if (j.empty_repo) {
      document.getElementById('modalLog').innerHTML = '<div class="diff-empty">这个文件还没有提交历史（仓库为空或文件未被提交过）</div>';
      return;
    }
    if (j.error) { document.getElementById('modalLog').innerHTML = '<div class="diff-empty">错误: ' + escHtml(j.error) + '</div>'; return; }
    renderHistory(j.commits || []);
  } catch (e) {
    document.getElementById('modalLog').innerHTML = '<div class="diff-empty">加载失败: ' + escHtml(e.message) + '</div>';
  }
}

function renderHistory(commits) {
  var el = document.getElementById('modalLog');
  if (!commits.length) {
    el.innerHTML = '<div class="diff-empty">还没有任何提交历史</div>';
    return;
  }
  var html = '<div class="hist-list">';
  commits.forEach(function(c) {
    var key = c.sha;
    var expanded = _histCtx.expanded === key;
    html += '<div class="hist-item' + (expanded ? ' expanded' : '') + '" id="hist-' + key + '">' +
      '<div class="hist-row">' +
        '<span class="hist-arrow" onclick="toggleCommit(\'' + key + '\')">' + (expanded ? '▼' : '▶') + '</span>' +
        '<span class="hist-sha" onclick="toggleCommit(\'' + key + '\')">' + escHtml(c.short) + '</span>' +
        '<span class="hist-msg" onclick="toggleCommit(\'' + key + '\')">' + escHtml(c.message) + '</span>' +
        '<span class="hist-meta">' + escHtml(c.author) + ' · ' + escHtml(c.date) + '</span>' +
        '<span class="hist-actions">' +
          '<button class="restore-btn" type="button" onclick="event.stopPropagation(); restoreFile(\'' + key + '\')">↺ 恢复到此版本</button>' +
        '</span>' +
      '</div>' +
      (expanded ? '<div class="diff-wrap" id="diff-' + key + '"><div class="diff-empty">加载差异...</div></div>' : '') +
    '</div>';
  });
  html += '</div>';
  el.innerHTML = html;
}

async function toggleCommit(sha) {
  // 如果已经展开 → 收起
  if (_histCtx.expanded === sha) {
    _histCtx.expanded = null;
    // 重新渲染（保持滚动位置太复杂，直接重渲染）
    var r2 = await fetch('/api/repos/file_history?owner=' + encodeURIComponent(_histCtx.owner) +
                        '&repo=' + encodeURIComponent(_histCtx.repo) +
                        '&path=' + encodeURIComponent(_histCtx.path));
    var j2 = await r2.json();
    renderHistory(j2.commits || []);
    return;
  }
  _histCtx.expanded = sha;
  // 展开前先重新渲染结构
  var r = await fetch('/api/repos/file_history?owner=' + encodeURIComponent(_histCtx.owner) +
                      '&repo=' + encodeURIComponent(_histCtx.repo) +
                      '&path=' + encodeURIComponent(_histCtx.path));
  var j = await r.json();
  renderHistory(j.commits || []);
  // 再加载 diff
  loadDiff(sha);
}

async function loadDiff(sha) {
  var wrap = document.getElementById('diff-' + sha);
  if (!wrap) return;
  try {
    var r = await fetch('/api/repos/file_diff?owner=' + encodeURIComponent(_histCtx.owner) +
                        '&repo=' + encodeURIComponent(_histCtx.repo) +
                        '&path=' + encodeURIComponent(_histCtx.path) +
                        '&sha=' + encodeURIComponent(sha));
    var j = await r.json();
    if (j.error) { wrap.innerHTML = '<div class="diff-empty">' + escHtml(j.error) + '</div>'; return; }
    wrap.innerHTML = renderDiff(j);
  } catch (e) {
    wrap.innerHTML = '<div class="diff-empty">加载失败: ' + escHtml(e.message) + '</div>';
  }
}

function renderDiff(d) {
  var html = '<div class="diff-header">' +
    '<span>状态: <b>' + escHtml(d.status) + '</b></span>' +
    '<span class="stat-add">+' + (d.additions || 0) + '</span>' +
    '<span class="stat-del">-' + (d.deletions || 0) + '</span>' +
    '<span class="commit-msg">' + escHtml((d.message || '').split('\n')[0]) + '</span>' +
  '</div>';
  if (!d.patch) {
    html += '<div class="diff-empty">无差异内容（可能是二进制文件或改动过大被 GitHub 截断）</div>';
    return html;
  }
  var lines = d.patch.split('\n');
  html += '<div class="diff-view">';
  lines.forEach(function(line) {
    var cls = 'diff-line ctx';
    if (line.indexOf('@@') === 0) cls = 'diff-line hunk';
    else if (line.indexOf('+++') === 0 || line.indexOf('---') === 0) cls = 'diff-line meta';
    else if (line.indexOf('+') === 0) cls = 'diff-line add';
    else if (line.indexOf('-') === 0) cls = 'diff-line del';
    html += '<div class="' + cls + '">' + escHtml(line) + '</div>';
  });
  html += '</div>';
  return html;
}


async function restoreFile(sha) {
  if (!_histCtx.owner || !_histCtx.repo || !_histCtx.path) return;
  var shortSha = sha.slice(0, 7);
  var confirmed = confirm(
    '⚠️ 恢复文件到旧版本\n\n' +
    '文件：' + _histCtx.path + '\n' +
    '目标 commit：' + shortSha + '\n\n' +
    '会把该文件当前内容替换成这个旧版本的内容，并提交一次新的 commit。\n' +
    '其他文件不受影响。\n\n' +
    '确认恢复？'
  );
  if (!confirmed) return;
  try {
    var r = await fetch('/api/repos/restore_file', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        owner: _histCtx.owner,
        repo: _histCtx.repo,
        path: _histCtx.path,
        sha: sha
      })
    });
    var j = await r.json();
    if (j.error) { alert('恢复失败: ' + j.error); return; }
    var msg = '✅ 已恢复到 ' + shortSha;
    if (j.commit_url) msg += '\n\n新提交：' + j.commit_url;
    alert(msg);
    // 刷新历史
    showFileHistory();
  } catch (e) {
    alert('请求失败: ' + e.message);
  }
}

function backToFilePreview() {
  document.getElementById('modalLog').style.display = 'none';
  if (typeof window._reloadPreview === 'function') window._reloadPreview();
}


function myPrompt(opts) {
  opts = opts || {};
  return new Promise(function(resolve) {
    var overlay = document.createElement('div');
    overlay.className = 'prompt-overlay';

    var box = document.createElement('div');
    box.className = 'prompt-box';

    var isMobile = window.innerWidth <= 640;
    var PAD = isMobile ? '16px 24px' : '18px 32px';
    var PAD_TOP = isMobile ? '16px 24px 0' : '18px 32px 0';
    var INPUT_MARGIN = isMobile ? '14px 24px 0' : '16px 32px 0';
    var INPUT_WIDTH = isMobile ? 'calc(100% - 48px)' : 'calc(100% - 64px)';
    var HINT_PAD = isMobile ? '10px 24px 0' : '12px 32px 0';
    var ACT_PAD = isMobile ? '16px 24px 14px' : '20px 32px 18px';

    var title = document.createElement('div');
    title.className = 'prompt-title';
    title.textContent = opts.title || '输入';
    title.style.cssText = 'padding:' + PAD + ';border-bottom:1px solid #25334f;font-weight:600;font-size:16px;color:#e2e8f0;letter-spacing:.2px';

    box.appendChild(title);

    if (opts.message) {
      var msg = document.createElement('div');
      msg.className = 'prompt-message';
      msg.textContent = opts.message;
      msg.style.cssText = 'padding:' + PAD_TOP + ';font-size:15px;color:#cbd5e1;line-height:1.7;white-space:pre-wrap;word-break:break-word';
      box.appendChild(msg);
    }

    var input = document.createElement('input');
    input.type = 'text';
    input.className = 'prompt-input';
    input.value = opts.defaultValue || '';
    input.placeholder = opts.placeholder || '';
    input.style.cssText = 'margin:' + INPUT_MARGIN + ';padding:13px 16px;background:#0f172a;border:1px solid #25334f;border-radius:10px;color:#e2e8f0;font-size:15px;font-family:inherit;outline:none;width:' + INPUT_WIDTH + ';box-sizing:border-box';
    box.appendChild(input);

    if (opts.hint) {
      var hint = document.createElement('div');
      hint.className = 'prompt-hint';
      hint.textContent = opts.hint;
      hint.style.cssText = 'padding:' + HINT_PAD + ';font-size:13px;color:#8b9cba;line-height:1.7;white-space:pre-wrap;word-break:break-all';
      box.appendChild(hint);
    }

    var actions = document.createElement('div');
    actions.className = 'prompt-actions';
    actions.style.cssText = 'display:flex;gap:12px;padding:' + ACT_PAD;
    var btnCancel = document.createElement('button');
    btnCancel.className = 'ghost';
    btnCancel.type = 'button';
    btnCancel.textContent = '取消';
    var btnOk = document.createElement('button');
    btnOk.type = 'button';
    btnOk.textContent = '确定';
    actions.appendChild(btnCancel);
    actions.appendChild(btnOk);
    box.appendChild(actions);
    overlay.appendChild(box);
    document.body.appendChild(overlay);

    var closed = false;
    function close(val) {
      if (closed) return;
      closed = true;
      document.removeEventListener('keydown', onKey);
      if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
      resolve(val);
    }

    function onKey(e) {
      if (e.key === 'Escape') close(null);
      else if (e.key === 'Enter' && document.activeElement === input) {
        e.preventDefault();
        close(input.value);
      }
    }

    btnCancel.addEventListener('click', function() { close(null); });
    btnOk.addEventListener('click', function() { close(input.value); });
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) close(null);
    });
    document.addEventListener('keydown', onKey);

    setTimeout(function() {
      input.focus();
      try { input.setSelectionRange(0, input.value.length); } catch (e) {}
    }, 60);
  });
}

function openModal(title, content) {
  document.getElementById('modalTitle').textContent = title || '日志';
  document.getElementById('modalLog').textContent = content || '';
  var _log = document.getElementById('modalLog');
  if (_log) _log.style.display = 'block';
  var _fl = document.getElementById('modalFileList');
  if (_fl) { _fl.style.display = 'none'; _fl.innerHTML = ''; }
  var _ed = document.getElementById('modalEditor');
  if (_ed) _ed.className = 'modal-editor';
  var _eb = document.getElementById('modalEditBtn');
  if (_eb) _eb.style.display = 'none';
  var _hb = document.getElementById('modalHistoryBtn');
  if (_hb) _hb.style.display = 'none';
  var _hb = document.getElementById('modalHistoryBtn');
  if (_hb) _hb.style.display = 'none';
  var _up = document.getElementById('uploadProgress');
  if (_up) _up.className = 'upload-progress';
  var _steps = document.getElementById('modalSteps');
  if (_steps) { _steps.style.display = 'none'; _steps.innerHTML = ''; }
  var _bb = document.getElementById('modalBackBtn');
  if (_bb) _bb.style.display = 'none';
  var ex = document.getElementById('modalExtras');
  if (ex) { ex.className = 'modal-extras'; ex.innerHTML = ''; }
  document.getElementById('modal').style.display = 'flex';
}
function closeModal() {
  document.getElementById('modal').style.display = 'none';
}

function renderLog(text) {
  var el = document.getElementById('modalLog');
  if (!el) return;
  el.style.display = 'block';
  var fl = document.getElementById('modalFileList');
  if (fl) fl.style.display = 'none';
  var escaped = escHtml(text == null ? '' : text);
  var linked = escaped.replace(/(https?:\/\/[^\s<>"']+)/g, function(u) {
    return '<a href="' + u + '" target="_blank" rel="noopener">' + u + '</a>';
  });
  el.innerHTML = linked;
}

function renderExtras(extras) {
  var el = document.getElementById('modalExtras');
  if (!el) return;
  if (!extras) { el.className = 'modal-extras'; el.innerHTML = ''; return; }
  var hasAny = extras.repo_url || extras.release_url || extras.pages_url ||
               (extras.assets && extras.assets.length);
  if (!hasAny) { el.className = 'modal-extras'; el.innerHTML = ''; return; }
  var html = '';
  if (extras.repo_url) {
    html += '<div class="xrow"><span class="xlabel">仓库</span><a href="' +
            escHtml(extras.repo_url) + '" target="_blank" rel="noopener">' +
            escHtml(extras.repo_url) + '</a></div>';
  }
  if (extras.release_url) {
    html += '<div class="xrow"><span class="xlabel">Release</span><a href="' +
            escHtml(extras.release_url) + '" target="_blank" rel="noopener">' +
            escHtml(extras.release_url) + '</a></div>';
  }
  if (extras.pages_url) {
    html += '<div class="xrow"><span class="xlabel">Pages</span><a href="' +
            escHtml(extras.pages_url) + '" target="_blank" rel="noopener">' +
            escHtml(extras.pages_url) + '</a></div>';
  }
  if (extras.assets && extras.assets.length) {
    extras.assets.forEach(function(a) {
      var url = a.accel || a.url;
      var cls = a.accel ? 'accel' : '';
      var label = a.accel ? '加速下载' : '下载';
      html += '<div class="xrow"><span class="xlabel">' + label + '</span>' +
              '<a class="' + cls + '" href="' + escHtml(url) +
              '" target="_blank" rel="noopener">' + escHtml(url) + '</a>' +
              (a.name ? '<span class="xname">(' + escHtml(a.name) + ')</span>' : '') +
              '</div>';
    });
  }
  el.innerHTML = html;
  el.className = 'modal-extras show';
}

var STEP_ORDER = ['create_repo', 'push_source', 'create_release', 'deploy_pages'];
var STEP_LABELS = {create_repo:'建仓库', push_source:'推代码', create_release:'建 Release', deploy_pages:'部署 Pages'};

function renderSteps(currentStep, status) {
  var el = document.getElementById('modalSteps');
  if (!el) return;
  el.style.display = 'flex';
  if (currentStep === 'done' || status === 'success') {
    var html = '';
    STEP_ORDER.forEach(function(k, i) {
      if (i > 0) html += '<span class="step-conn"></span>';
      html += '<div class="step-item done"><span class="step-dot"></span><span>' + STEP_LABELS[k] + '</span></div>';
    });
    el.innerHTML = html;
    return;
  }
  var idx = STEP_ORDER.indexOf(currentStep);
  if (idx < 0) { el.style.display = 'none'; return; }
  var html = '';
  STEP_ORDER.forEach(function(k, i) {
    if (i > 0) html += '<span class="step-conn"></span>';
    var cls = 'step-item';
    if (i < idx) cls += ' done';
    else if (i === idx) cls += (status === 'failed' ? ' failed' : ' active');
    html += '<div class="' + cls + '"><span class="step-dot"></span><span>' + STEP_LABELS[k] + '</span></div>';
  });
  el.innerHTML = html;
}

document.addEventListener('DOMContentLoaded', function () {
  var m = document.getElementById('modal');
  if (m) m.addEventListener('click', function (e) {
    if (e.target.id === 'modal') closeModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });
});
</script>
{% block scripts %}{% endblock %}
</div>

<div id="readmeDialog" class="modal-overlay" style="display:none;z-index:200">
  <div class="modal-box" style="max-width:900px">
    <div class="modal-head">
      <span class="modal-title" id="readmeTitle">生成 README</span>
      <button class="modal-close" type="button" onclick="closeReadmeDialog()" aria-label="关闭">✕</button>
    </div>
    <div class="readme-dialog-body">
      <div class="readme-dialog-toolbar">
        <span class="info" id="readmeInfo">加载中...</span>
        <button class="ghost" type="button" onclick="regenerateReadme()">🔄 重新生成</button>
      </div>
      <textarea id="readmeTextarea" spellcheck="false"></textarea>
    </div>
    <div class="readme-dialog-actions">
      <button class="ghost" type="button" onclick="closeReadmeDialog()">取消</button>
      <button type="button" onclick="saveReadmeToRepo()" id="readmeSaveBtn">保存到仓库</button>
    </div>
  </div>
</div>

</body>
</html>
