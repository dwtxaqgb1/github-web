# ===== GitHub 发布工具环境配置 =====
# 复制本文件为 .env，然后按需修改，再执行：
#   docker compose down
#   docker compose up -d --build --force-recreate

# Web 访问端口
HOST_PORT=5110

# 数据目录（保存配置、加密 Token、SSH 密钥、任务日志）
# 相对路径 ./data 表示和 docker-compose.yml 同级
NAS_DATA_DIR=/vol1/1000/我的文件/github/data

# 工作目录（上传暂存、解压、克隆都放这里）
# 容器内的路径是 /work
NAS_WORK_DIR=/vol1/1000/我的文件/github/work

# 可选：额外挂载一个 NAS 目录到容器里的 /nas
# 用于"克隆"功能支持任意 NAS 路径，填了之后网页上可以输入 /nas/xxx
# 不填则只能用 /work 下
# 例如：NAS_EXTRA_DIR=/vol1/1000/我的文件
NAS_EXTRA_DIR=

# 首次启动时的登录密码（已存在配置时忽略）
ADMIN_PASSWORD=admin123
